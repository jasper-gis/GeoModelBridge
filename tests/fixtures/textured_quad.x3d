<?xml version="1.0" encoding="UTF-8"?>
<!-- Original GeoModelBridge fixture, CC0. Y-up metres, 2 x 3 metre quad. -->
<X3D profile="Interchange" version="3.3">
  <Scene>
    <Transform DEF="Placement" translation="10 1 2">
      <Shape DEF="Quad">
        <Appearance>
          <Material diffuseColor="1 1 1" ambientIntensity="0" transparency="0"/>
          <ImageTexture url='"checker.png"'/>
          <TextureTransform translation="0.25 0.125" scale="0.5 0.5"/>
        </Appearance>
        <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1" normalPerVertex="false" normalIndex="0" texCoordIndex="0 1 2 3 -1">
          <Coordinate point="0 0 0, 2 0 0, 2 0 -3, 0 0 -3"/>
          <Normal vector="0 1 0"/>
          <TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
  </Scene>
</X3D>
