{
  "version": 3,
  "configurePresets": [
    { "name": "release", "displayName": "Release (Ninja)", "generator": "Ninja", "binaryDir": "${sourceDir}/build/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "GMB_BUILD_TESTS": "ON" } },
    { "name": "debug", "displayName": "Debug (Ninja)", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GMB_BUILD_TESTS": "ON" } }
  ],
  "buildPresets": [ { "name": "release", "configurePreset": "release" }, { "name": "debug", "configurePreset": "debug" } ],
  "testPresets": [ { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }, { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } } ]
}
