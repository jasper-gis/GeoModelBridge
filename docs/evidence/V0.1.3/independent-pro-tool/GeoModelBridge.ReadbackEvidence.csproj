<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.3</Version>
    <AssemblyName>GeoModelBridge.ReadbackEvidence</AssemblyName>
    <ArcGISProInstallDir Condition="'$(ArcGISProInstallDir)' == ''">C:\Program Files\ArcGIS\Pro</ArcGISProInstallDir>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ArcGIS.Core"><HintPath>$(ArcGISProInstallDir)\bin\ArcGIS.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.CoreHost"><HintPath>$(ArcGISProInstallDir)\bin\ArcGIS.CoreHost.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckArcGISPro" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ArcGISProInstallDir)\bin\ArcGIS.Core.dll')" Text="An installed ArcGIS Pro is required (tested with 3.6.2). Set /p:ArcGISProInstallDir to the installed folder. No Esri DLLs are distributed by this project." />
  </Target>
</Project>
