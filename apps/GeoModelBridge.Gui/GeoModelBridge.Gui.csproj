<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.5</Version>
    <AssemblyName>geomodelbridgeGUI</AssemblyName>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <RootNamespace>GeoModelBridge.Gui</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Product>GeoModelBridge GUI</Product>
    <Description>三维模型转换工具 · FBX to FileGDB Multipatch</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/AppIcon.ico" />
    <ProjectReference Include="../GeoModelBridge.Gui.Core/GeoModelBridge.Gui.Core.csproj" />
    <Content Include="../../tests/fixtures/textured_quad.fbx" Link="demo/textured_quad.fbx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../tests/fixtures/checker.png" Link="demo/checker.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
