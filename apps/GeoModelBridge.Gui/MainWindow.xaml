<Window x:Class="GeoModelBridge.Gui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GeoModelBridge · V0.1.5" Icon="Assets/AppIcon.ico" Width="1280" Height="850" MinWidth="1080" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#F3F6F9" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#12343F">
   <Grid Margin="22,30,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Width="45" Height="45" CornerRadius="10" Background="#1C5360" HorizontalAlignment="Left" Margin="0,0,0,18">
      <Canvas Width="30" Height="32">
       <Path Data="M15,2 L28,9 L15,16 L2,9 Z" Fill="#6DE0CD"/>
       <Path Data="M2,11 L14,18 L14,31 L2,24 Z" Fill="#2FA8B6"/>
       <Path Data="M16,18 L28,11 L28,24 L16,31 Z" Fill="#BCF1EA"/>
      </Canvas>
     </Border>
     <TextBlock Text="GeoModel" Foreground="White" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="Bridge" Foreground="#75DDCE" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="三维模型转换工具" Foreground="#A4BEC7" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#235360" CornerRadius="7" Padding="14,12" Margin="-3,38,-3,0">
     <TextBlock Text="▣   模型转换" Foreground="White" FontWeight="SemiBold"/>
    </Border>
    <StackPanel Grid.Row="3">
     <TextBlock Text="FBX → MULTIPATCH" Foreground="#86A6B1" FontSize="10"/>
     <TextBlock Text="V0.1.5  ·  Windows x64" Foreground="#C3D5DC" FontSize="11" Margin="0,9,0,0"/>
     <Button Content="使用说明 ↗" Click="Help_Click" Margin="0,19,0,0" Background="#1C4653" BorderBrush="#34616D" Foreground="White"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,26,28,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="FBX → FileGDB" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="将静态模型转换为带材质的 Multipatch" Foreground="{StaticResource Muted}" Margin="0,7,0,0" FontSize="13"/></StackPanel>
    <Button Grid.Column="1" x:Name="DemoButton" Content="加载演示" Click="Demo_Click" VerticalAlignment="Center" ToolTip="加载项目测试模型，并填入仅供演示的坐标。不会立即转换。"/>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="InputPanel" Margin="0,0,4,2">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="01   选择模型与输出" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,19"/>
        <TextBlock Text="输入 FBX" Style="{StaticResource Label}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="InputPathBox" AutomationProperties.Name="输入FBX路径" ToolTip="可输入路径或拖入一个 FBX 文件" PreviewDragOver="Input_DragOver" PreviewDrop="Input_Drop" AllowDrop="True" TextChanged="InputPath_Changed"/>
         <Button Grid.Column="1" Content="浏览…" Click="BrowseInput_Click" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="输出地理数据库 (.gdb)" Style="{StaticResource Label}" Margin="0,17,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="OutputPathBox" AutomationProperties.Name="输出GDB路径" ToolTip="请输入尚不存在的新 .gdb 目录路径"/>
         <Button Grid.Column="1" Content="目录…" Click="BrowseOutput_Click" Margin="8,0,0,0"/>
         <Button Grid.Column="2" Content="换个新名称" Click="NewOutput_Click" Margin="8,0,0,0" Padding="10,9" FontSize="12" ToolTip="保留原数据库和报告，生成一个尚未使用的新名称。不会立即转换。"/>
        </Grid>
        <TextBlock Text="输出必须为新路径，现有数据库不会被覆盖。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="转换策略" Style="{StaticResource Label}" Margin="0,17,0,7"/>
        <ComboBox x:Name="ProfileBox" SelectedIndex="0" Padding="9,8" FontSize="13" SelectionChanged="Profile_Changed" AutomationProperties.Name="转换策略">
         <ComboBoxItem Content="GIS 静态兼容（默认）" Tag="gis-static"/>
         <ComboBoxItem Content="严格检查" Tag="strict"/>
        </ComboBox>
        <TextBlock x:Name="ProfileHint" Text="按 FBX 保存的姿态转换；保留几何、常规颜色、漫反射贴图和 UV；省略环境光、高光及反射，删除零面积面；修复符合条件的 JPEG 封装，不重新压缩图像。处理均写入报告。" Foreground="#795415" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="02   设置模型位置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,19"/>
        <TextBlock Text="投影坐标系 WKID（米制）" Style="{StaticResource Label}"/>
        <TextBox x:Name="WkidBox" AutomationProperties.Name="WKID" ToolTip="例如 32650 表示 WGS 84 / UTM zone 50N；请按模型的实际坐标系填写"/>
        <Grid Margin="0,17,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="原点 X（米）" Style="{StaticResource Label}"/><TextBox x:Name="OriginXBox" AutomationProperties.Name="原点X"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="原点 Y（米）" Style="{StaticResource Label}"/><TextBox x:Name="OriginYBox" AutomationProperties.Name="原点Y"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="原点 Z（米）" Style="{StaticResource Label}"/><TextBox x:Name="OriginZBox" AutomationProperties.Name="原点Z"/></StackPanel>
        </Grid>
        <TextBlock Text="模型将统一为 Z 轴向上、米制，再加上原点偏移。此设置不执行重投影或地理配准。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="18"/>
        <Border x:Name="DemoNotice" Visibility="Collapsed" Background="#FFF5DD" Padding="10" CornerRadius="5" Margin="0,12,0,0"><TextBlock Text="当前为演示坐标，不代表模型的真实地理位置。" Foreground="#865B13" FontSize="11" TextWrapping="Wrap"/></Border>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <Expander Header="转换选项" IsExpanded="True" FontSize="14" FontWeight="SemiBold">
        <StackPanel Margin="0,15,0,0">
         <TextBlock Text="转换后端" Style="{StaticResource Label}"/>
         <TextBlock Text="原生 FileGDB 转换引擎" FontSize="13" FontWeight="Normal" AutomationProperties.Name="转换后端"/>
         <TextBlock x:Name="BackendHint" Text="无需 ArcGIS Pro，使用随程序提供的 FileGDB 运行库。" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Normal" TextWrapping="Wrap" Margin="0,9,0,15"/>
         <TextBlock Text="输出要素类名称" Style="{StaticResource Label}"/>
         <TextBox x:Name="FeatureClassBox" Text="Models" AutomationProperties.Name="要素类名称" FontWeight="Normal"/>
         <Grid Margin="0,17,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="额外贴图目录（可选，每行一个）" VerticalAlignment="Center" FontSize="12"/>
          <Button Grid.Column="1" Content="添加…" Click="AddTexture_Click" Padding="10,5" MinHeight="30" FontSize="11"/>
         </Grid>
         <TextBox x:Name="TextureDirectoriesBox" AutomationProperties.Name="额外贴图目录" AcceptsReturn="True" Height="70" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" FontWeight="Normal"/>
        </StackPanel>
       </Expander>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="运行状态" Foreground="{StaticResource Muted}" FontSize="12"/>
       <TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="StatusMessage" Text="选择模型并填写坐标，也可以先加载演示模型。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
       </ScrollViewer>
       <ProgressBar x:Name="BusyIndicator" Height="3" Margin="0,16,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
      </StackPanel>
      <Button Grid.Row="1" x:Name="ProbeButton" Content="检查运行环境" Click="Probe_Click" Margin="0,17,0,18"/>
      <TextBlock Grid.Row="2" Text="转换日志" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox Grid.Row="3" x:Name="LogBox" AutomationProperties.Name="转换日志" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F5F8FA" BorderThickness="0" Foreground="#45616C" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11" VerticalContentAlignment="Top" Padding="10"/>
      <StackPanel Grid.Row="4" Margin="0,16,0,0">
       <Button x:Name="OpenOutputButton" Content="打开输出目录 ↗" Click="OpenOutput_Click" IsEnabled="False"/>
       <Button x:Name="ReportButton" Content="查看转换报告" Click="Report_Click" IsEnabled="False" Margin="0,8,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="2" Margin="0,20,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
     <TextBlock Text="保留常规颜色、UV 与内嵌贴图" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock Text="兼容处理会明确记录；未知或损坏内容仍会停止转换。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <Button x:Name="ConvertButton" Grid.Column="1" Content="开始转换 →" Style="{StaticResource PrimaryButton}" Width="160" Height="46" Click="Convert_Click" IsDefault="True"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
